<!-- AI CHAT BOX -->
<section class="zz-chatbox" id="zzAiChat" aria-label="Tư vấn điện thoại" aria-hidden="true">
    <div class="zz-chatbox__head">
        <div class="zz-chatbox__avatar">AI</div>
        <div>
            <strong>Zuzong AI</strong>
            <span>Gemini hỗ trợ chọn máy theo nhu cầu</span>
        </div>
        <button type="button" class="zz-chatbox__close" id="zzChatClose" aria-label="Đóng chat">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
        </button>
    </div>

    <div class="zz-chatbox__messages" id="zzChatMessages">
        <div class="zz-chatbox__msg zz-chatbox__msg--bot">
            <div class="zz-chatbox__bubble">
                Chào bạn, mình là Zuzong AI. Bạn nói ngân sách, hãng thích dùng hoặc nhu cầu như game, camera, pin; mình sẽ lọc máy trong shop và tư vấn nhanh cho bạn.
            </div>
        </div>
    </div>

    <div class="zz-chatbox__suggestions">
        <button type="button" data-chat-suggest="Tầm 5 triệu chơi game">5 triệu chơi game</button>
        <button type="button" data-chat-suggest="Camera đẹp dưới 10 triệu">Camera dưới 10 triệu</button>
        <button type="button" data-chat-suggest="Pin trâu cho sinh viên">Pin trâu sinh viên</button>
        <button type="button" data-chat-suggest="Shop ở đâu?">Shop ở đâu?</button>
        <button type="button" data-chat-suggest="Liên hệ shop như nào?">Liên hệ shop</button>
    </div>

    <form class="zz-chatbox__form" data-chat-form>
        <input id="zzChatInput" type="text" autocomplete="off"
               placeholder="Nhập nhu cầu của bạn..." aria-label="Nhập nhu cầu tư vấn" />
        <button type="submit" aria-label="Gửi tin nhắn">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                <line x1="22" y1="2" x2="11" y2="13"></line>
                <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
            </svg>
        </button>
    </form>
</section>

<!-- FLOATING ACTION BUTTONS -->
<div class="zz-fab-stack">
    <button type="button" id="zzChatToggle" class="zz-fab zz-fab--chat"
            title="Chat tư vấn điện thoại" aria-controls="zzAiChat" aria-expanded="false">
        <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4z"></path>
            <path d="M8 9h8"></path>
            <path d="M8 13h5"></path>
        </svg>
    </button>
    <a href="https://www.facebook.com/duong.nhut.thinh"
       target="_blank" class="zz-fab zz-fab--fb" title="Facebook của mình">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
        </svg>
    </a>
    <button id="zzBackToTop" class="zz-fab zz-fab--top" title="Lên đầu trang">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="19" x2="12" y2="5"></line>
            <polyline points="5 12 12 5 19 12"></polyline>
        </svg>
    </button>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
<script src="~/js/zuzong-chatbot.js" asp-append-version="true"></script>

<script>
(function () {
    // ── Navbar fixed cho trang không phải home ──
    var nav = document.getElementById('zzNav');
    if (nav && !document.body.classList.contains('page-home')) {
        nav.style.position   = 'fixed';
        nav.style.background = 'var(--zz-nav-bg)';
        nav.style.backdropFilter = 'blur(16px)';
        nav.style.borderBottom   = '1px solid var(--zz-card-border)';
    }

    // ── Toggle Dark / Light Mode ──
    const toggleBtn = document.getElementById('themeToggleBtn');
    const themeIcon = document.getElementById('themeIcon');
    const htmlEl    = document.documentElement;

    const sunSVG  = `<circle cx="12" cy="12" r="5"></circle>
        <line x1="12" y1="1" x2="12" y2="3"></line>
        <line x1="12" y1="21" x2="12" y2="23"></line>
        <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
        <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
        <line x1="1" y1="12" x2="3" y2="12"></line>
        <line x1="21" y1="12" x2="23" y2="12"></line>
        <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
        <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>`;
    const moonSVG = `<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>`;

    function updateIcon(isLight) { themeIcon.innerHTML = isLight ? moonSVG : sunSVG; }
    updateIcon(htmlEl.classList.contains('theme-light'));

    if (toggleBtn) {
        toggleBtn.addEventListener('click', () => {
            htmlEl.classList.toggle('theme-light');
            const isLight = htmlEl.classList.contains('theme-light');
            localStorage.setItem('theme', isLight ? 'light' : 'dark');
            updateIcon(isLight);
        });
    }

    // ── Back To Top ──
    const backToTopBtn = document.getElementById('zzBackToTop');
    if (backToTopBtn) {
        const fabStack = backToTopBtn.closest('.zz-fab-stack');

        const getScrollTop = () => Math.max(
            window.scrollY || 0,
            document.documentElement.scrollTop || 0,
            document.body.scrollTop || 0
        );

        const syncBackToTop = () => {
            if (fabStack) {
                fabStack.classList.toggle('show-top', getScrollTop() > 400);
            }
        };

        window.addEventListener('scroll', syncBackToTop, { passive: true });
        document.addEventListener('scroll', syncBackToTop, { passive: true });
        document.documentElement.addEventListener('scroll', syncBackToTop, { passive: true });
        document.body.addEventListener('scroll', syncBackToTop, { passive: true });
        syncBackToTop();

        backToTopBtn.addEventListener('click', () => {
            const scrollOptions = { top: 0, left: 0, behavior: 'smooth' };
            [window, document.scrollingElement, document.documentElement, document.body].forEach(target => {
                try {
                    target?.scrollTo(scrollOptions);
                } catch {
                    try { target?.scrollTo(0, 0); } catch { }
                }
            });

            setTimeout(() => {
                try { document.documentElement.scrollTop = 0; } catch { }
                try { document.body.scrollTop = 0; } catch { }
                syncBackToTop();
            }, 450);
        });
    }
    // ── TOAST SYSTEM ──
    function zzShowToast(title, msg) {
        var container = document.getElementById('zzToastContainer');
        var toast = document.createElement('div');
        toast.className = 'zz-toast';
        toast.innerHTML = `
            <div class="zz-toast__icon">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
            </div>
            <div class="zz-toast__body">
                <div class="zz-toast__title">${title}</div>
                <div class="zz-toast__msg">${msg}</div>
            </div>
            <div class="zz-toast__progress"></div>`;
        container.appendChild(toast);
        requestAnimationFrame(() => toast.classList.add('show'));
        setTimeout(() => {
            toast.classList.add('hide');
            setTimeout(() => toast.remove(), 400);
        }, 3000);
    }

    // ── CẬP NHẬT BADGE ──
    function zzUpdateCartBadge(count) {
        var badge = document.getElementById('zzCartBadge');
        if (!badge) return;
        badge.textContent    = count;
        badge.style.display  = count > 0 ? 'inline-flex' : 'none';
    }

    // ── THÊM GIỎ HÀNG AJAX ──
    document.addEventListener('click', function (e) {
        var btn = e.target.closest('[data-them-gio]');
        if (!btn) return;
        e.preventDefault();

        var maSp  = btn.dataset.themGio;
        var maBienThe = btn.dataset.maBienThe || '';
        var token = document.querySelector('input[name="__RequestVerificationToken"]');

        fetch('/GioHang/ThemVaoGioAjax', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'RequestVerificationToken': token ? token.value : ''
            },
            body: 'maSp=' + encodeURIComponent(maSp) + '&maBienThe=' + encodeURIComponent(maBienThe)
        })
        .then(r => r.json())
        .then(function (data) {
            if (data.success) {
                var msg = data.bienThe ? data.tenSp + ' · ' + data.bienThe : data.tenSp;
                zzShowToast('Đã thêm vào giỏ!', msg);
                zzUpdateCartBadge(data.soLuong);
            } else {
                zzShowToast('Chưa đăng nhập', data.message || 'Vui lòng đăng nhập để mua hàng');
            }
        })
        .catch(function () {
            zzShowToast('Lỗi kết nối', 'Vui lòng thử lại');
        });
    });
})();
</script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
