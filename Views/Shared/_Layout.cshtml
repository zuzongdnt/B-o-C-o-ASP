@using dienthoai.Models
@inject QuanLyDienThoaiZuzongContext _context
@using Microsoft.AspNetCore.Http
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Zuzong Store</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/zuzong-hero.css" asp-append-version="true" />

    <script>
        if (localStorage.getItem('theme') === 'light') {
            document.documentElement.classList.add('theme-light');
        }
    </script>

    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="@(ViewData["BodyClass"])">

<div class="zz-toast-container" id="zzToastContainer"></div>

@{
    var avatar      = Context.Session.GetString("Avatar");
    var maTaiKhoan  = Context.Session.GetString("MaTaiKhoan");
    var tenDangNhap = Context.Session.GetString("TenDangNhap");
    var hoTen       = Context.Session.GetString("HoTen");
    var vaiTro      = Context.Session.GetString("VaiTro");
    var listThuongHieu = _context.ThuongHieus.ToList();
    var brandStats = listThuongHieu
        .Select(th => new
        {
            th.MaThuongHieu,
            th.TenThuongHieu,
            ProductCount = _context.SanPhams.Count(sp => sp.MaThuongHieu == th.MaThuongHieu && sp.TrangThai == true)
        })
        .OrderByDescending(th => th.ProductCount)
        .ThenBy(th => th.TenThuongHieu)
        .ToList();

    // ── Badge giỏ hàng ──
    int cartCount = 0;
    if (!string.IsNullOrEmpty(maTaiKhoan))
    {
        int uid = int.Parse(maTaiKhoan);
        var gh  = _context.GioHangs.FirstOrDefault(g => g.MaTaiKhoan == uid);
        if (gh != null)
        {
            cartCount = _context.ChiTietGioHangs
                .Where(c => c.MaGioHang == gh.MaGioHang)
                .Sum(c => c.SoLuong);
        }
    }
}

<nav class="zz-nav" id="zzNav">
    <a class="zz-pill zz-pill--logo" asp-controller="Home" asp-action="Index">
        <svg viewBox="0 0 256 256" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path class="zz-logo-path"
                  d="M128 192 L128 256 L64.5 256 L32 223 L0 192 L0 128 L64 128 Z
                     M256 192 L256 256 L192.5 256 L160 223 L128 192 L128 128 L192 128 Z
                     M128 64  L128 128 L64.5 128 L32 95  L0 64  L0 0   L64 0  Z
                     M256 64  L256 128 L192.5 128 L160 95 L128 64 L128 0 L192 0 Z"
                  fill="#ffffff" />
        </svg>
        <span class="zz-brand">ZuzongStore</span>
    </a>

    <div class="zz-pill zz-pill--links d-none d-md-flex">
        <a class="nav-link" asp-controller="Home" asp-action="Index">Trang chủ</a>
        <div class="dropdown zz-brand-dropdown">
            <a class="nav-link dropdown-toggle" href="#" role="button"
               data-bs-toggle="dropdown" aria-expanded="false">
                Sản phẩm
            </a>
            <div class="dropdown-menu zz-brand-menu">
                <div class="zz-brand-menu__head">
                    <div>
                        <span>Danh mục</span>
                        <strong>Chọn thương hiệu</strong>
                    </div>
                    <a asp-controller="SanPham" asp-action="Index">Tất cả sản phẩm</a>
                </div>

                <div class="zz-brand-menu__grid">
                    @foreach (var item in brandStats)
                    {
                        var brandName = string.IsNullOrWhiteSpace(item.TenThuongHieu) ? "Zuzong" : item.TenThuongHieu;
                        <a class="zz-brand-menu__item"
                           asp-controller="SanPham" asp-action="Index"
                           asp-route-maThuongHieu="@item.MaThuongHieu">
                            <span class="zz-brand-menu__mark">@brandName.Substring(0, 1).ToUpper()</span>
                            <span>
                                <strong>@brandName</strong>
                                <small>@item.ProductCount sản phẩm</small>
                            </span>
                        </a>
                    }
                </div>
            </div>
        </div>
        <a class="nav-link" asp-controller="Home" asp-action="Privacy">Chính sách</a>
    </div>

    <div class="zz-nav__actions d-flex align-items-center gap-2">

        <!-- THEME TOGGLE -->
        <button id="themeToggleBtn" class="zz-icon-btn" title="Đổi giao diện">
            <svg id="themeIcon" width="20" height="20" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="5"></circle>
                <line x1="12" y1="1" x2="12" y2="3"></line>
                <line x1="12" y1="21" x2="12" y2="23"></line>
                <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
                <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
                <line x1="1" y1="12" x2="3" y2="12"></line>
                <line x1="21" y1="12" x2="23" y2="12"></line>
                <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
                <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
            </svg>
        </button>

        <!-- GIỎ HÀNG + BADGE -->
        <a class="zz-cart-btn" asp-controller="GioHang" asp-action="Index">
            🛒 <span>Giỏ hàng</span>
            <span class="zz-cart-badge" id="zzCartBadge"
                  style="@(cartCount > 0 ? "" : "display:none")">
                @cartCount
            </span>
        </a>

        <!-- USER DROPDOWN -->
        @if (!string.IsNullOrEmpty(tenDangNhap))
        {
            <div class="dropdown">
                <button class="zz-user-btn dropdown-toggle d-flex align-items-center gap-2"
                        data-bs-toggle="dropdown" aria-expanded="false"
                        style="padding: 0.25rem 0.8rem 0.25rem 0.25rem;">
                    @if (!string.IsNullOrEmpty(avatar))
                    {
                        <img src="~/images/@avatar" class="rounded-circle border border-secondary"
                             width="28" height="28" style="object-fit:cover;" />
                    }
                    else
                    {
                        <div class="bg-secondary text-white rounded-circle d-flex justify-content-center align-items-center fw-bold"
                             style="width:28px;height:28px;font-size:14px;">
                            @(hoTen?.Substring(0, 1).ToUpper() ?? "U")
                        </div>
                    }
                    <span>@hoTen?.ToLower()</span>
                </button>
                <ul class="dropdown-menu dropdown-menu-end zz-user-dropdown">
                    @if (vaiTro == "Admin")
                    {
                        <li><a class="dropdown-item" asp-controller="TaiKhoan" asp-action="Dashboard">Bảng điều khiển</a></li>
                    }
                    else
                    {
                        <li><a class="dropdown-item" asp-controller="DonHang" asp-action="LichSuDonHang">Lịch sử đơn hàng</a></li>
                    }
                    <li><a class="dropdown-item" asp-controller="TaiKhoan" asp-action="Details" asp-route-id="@maTaiKhoan">Quản lý tài khoản</a></li>
                    <li><hr class="dropdown-divider" /></li>
                    <li><a class="dropdown-item text-danger" asp-controller="TaiKhoan" asp-action="Logout">Đăng xuất</a></li>
                </ul>
            </div>
        }
        else
        {
            <a class="zz-cta-btn" asp-controller="TaiKhoan" asp-action="Login">Đăng nhập</a>
        }

        <button class="zz-nav__toggle d-md-none"
                data-bs-toggle="collapse" data-bs-target="#zzMobileMenu" aria-expanded="false">
            ☰
        </button>
    </div>
</nav>

<!-- MOBILE MENU -->
<div class="collapse" id="zzMobileMenu"
     style="position:fixed;top:5rem;left:1rem;right:1rem;z-index:99;
            background:rgba(18,18,18,0.97);border-radius:1rem;padding:1rem;
            backdrop-filter:blur(14px);border:1px solid rgba(255,255,255,0.1);">
    <a class="dropdown-item" asp-controller="Home" asp-action="Index">Trang chủ</a>
    <a class="dropdown-item" asp-controller="SanPham" asp-action="Index">Tất cả sản phẩm</a>
    @foreach (var item in listThuongHieu)
    {
        <a class="dropdown-item"
           asp-controller="SanPham" asp-action="Index"
           asp-route-maThuongHieu="@item.MaThuongHieu">
            @item.TenThuongHieu.ToLower()
        </a>
    }
    <hr class="dropdown-divider" />
    <a class="dropdown-item" asp-controller="Home" asp-action="Privacy">Chính sách</a>
    @if (string.IsNullOrEmpty(tenDangNhap))
    {
        <a class="dropdown-item" asp-controller="TaiKhoan" asp-action="Login">Đăng nhập</a>
    }
    else
    {
        <a class="dropdown-item" asp-controller="TaiKhoan" asp-action="Details" asp-route-id="@maTaiKhoan">Tài khoản</a>
        <a class="dropdown-item text-danger" asp-controller="TaiKhoan" asp-action="Logout">Đăng xuất</a>
    }
</div>

