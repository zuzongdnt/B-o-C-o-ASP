@model IEnumerable<dienthoai.Models.ChiTietGioHang>

@{
    ViewData["Title"] = "Giỏ hàng của bạn";
    ViewData["BodyClass"] = "page-cart";

    var items = Model?.ToList() ?? new List<dienthoai.Models.ChiTietGioHang>();
    decimal tongTienTatCa = 0;
    int tongSoLuong = items.Sum(x => x.SoLuong);
}

@section Styles {
    <link rel="stylesheet" href="~/css/zuzong-cart.css" asp-append-version="true" />
}

<section class="zz-cart-page">
    <div class="zz-cart-header">
        <div>
            <p class="zz-cart-eyebrow">ZUZONG STORE</p>
            <h1>Giỏ hàng của bạn</h1>
            <span>@tongSoLuong sản phẩm đang chờ thanh toán</span>
        </div>

        <a asp-controller="SanPham" asp-action="Index" class="zz-cart-link-btn">
            Mua thêm
        </a>
    </div>

    @if (!items.Any())
    {
        <div class="zz-cart-empty">
            <div class="zz-cart-empty__icon">
                <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="8" cy="21" r="1"></circle>
                    <circle cx="19" cy="21" r="1"></circle>
                    <path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h8.77a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"></path>
                </svg>
            </div>
            <h2>Giỏ hàng đang trống</h2>
            <p>Chọn một chiếc máy hợp gu rồi quay lại đây để kiểm tra màu, dung lượng và tổng tiền.</p>
            <a asp-controller="SanPham" asp-action="Index" class="zz-cart-primary-btn">Tiếp tục mua sắm</a>
        </div>
    }
    else
    {
        <div class="zz-cart-layout">
            <div class="zz-cart-list">
                @foreach (var item in items)
                {
                    var sanPham = item.MaSpNavigation;
                    var bienThe = item.MaBienTheNavigation;
                    decimal donGia = bienThe?.GiaBan ?? sanPham.GiaBan;
                    decimal? giaGoc = bienThe?.GiaGoc ?? sanPham.GiaGoc;
                    var thanhTien = item.SoLuong * donGia;
                    tongTienTatCa += thanhTien;

                    string? hinhAnh = !string.IsNullOrEmpty(bienThe?.HinhAnh) ? bienThe.HinhAnh : sanPham.HinhAnh;
                    string detailUrl = Url.Action("Details", "SanPham", new { id = item.MaSp, maBienThe = item.MaBienThe }) ?? "#";

                    <article class="zz-cart-item" data-detail-url="@detailUrl">
                        <a href="@detailUrl" class="zz-cart-item__media" aria-label="Xem chi tiết @sanPham.TenSp">
                            @if (!string.IsNullOrEmpty(hinhAnh))
                            {
                                <img src="~/images/@hinhAnh" alt="@sanPham.TenSp"
                                     onerror="this.src='https://via.placeholder.com/180?text=No+Image'" />
                            }
                            else
                            {
                                <span>Phone</span>
                            }
                        </a>

                        <div class="zz-cart-item__info">
                            <a href="@detailUrl" class="zz-cart-item__name">@sanPham.TenSp</a>

                            <div class="zz-cart-item__meta">
                                @if (bienThe != null)
                                {
                                    <span>
                                        @if (!string.IsNullOrEmpty(bienThe.MaMau))
                                        {
                                            <i style="background:@bienThe.MaMau"></i>
                                        }
                                        @bienThe.MauSac
                                    </span>
                                    <span>@bienThe.DungLuong</span>
                                }
                                else
                                {
                                    <span>Phiên bản mặc định</span>
                                }
                            </div>

                            <div class="zz-cart-item__price">
                                <strong>@donGia.ToString("N0")đ</strong>
                                @if (giaGoc.HasValue && giaGoc > donGia)
                                {
                                    <small>@giaGoc.Value.ToString("N0")đ</small>
                                }
                            </div>
                        </div>

                        <div class="zz-cart-qty" aria-label="Cập nhật số lượng">
                            <form asp-controller="GioHang" asp-action="GiamSoLuong" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="maChiTietGioHang" value="@item.MaChiTietGioHang" />
                                <button type="submit" title="Giảm số lượng">−</button>
                            </form>
                            <span>@item.SoLuong</span>
                            <form asp-controller="GioHang" asp-action="TangSoLuong" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="maChiTietGioHang" value="@item.MaChiTietGioHang" />
                                <button type="submit" title="Tăng số lượng">+</button>
                            </form>
                        </div>

                        <div class="zz-cart-line-total">
                            <span>Thành tiền</span>
                            <strong>@thanhTien.ToString("N0")đ</strong>
                        </div>

                        <form asp-controller="GioHang" asp-action="XoaSanPham" method="post" class="zz-cart-remove">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="maChiTietGioHang" value="@item.MaChiTietGioHang" />
                            <button type="submit" title="Xóa sản phẩm">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                     stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M3 6h18"></path>
                                    <path d="M8 6V4h8v2"></path>
                                    <path d="M19 6l-1 14H6L5 6"></path>
                                    <path d="M10 11v5"></path>
                                    <path d="M14 11v5"></path>
                                </svg>
                            </button>
                        </form>
                    </article>
                }
            </div>

            <aside class="zz-cart-summary">
                <div class="zz-cart-summary__head">
                    <span>Tóm tắt đơn hàng</span>
                    <strong>@tongSoLuong món</strong>
                </div>

                <div class="zz-cart-summary__row">
                    <span>Tạm tính</span>
                    <strong>@tongTienTatCa.ToString("N0")đ</strong>
                </div>
                <div class="zz-cart-summary__row">
                    <span>Giao hàng</span>
                    <strong>Miễn phí</strong>
                </div>
                <div class="zz-cart-summary__divider"></div>
                <div class="zz-cart-summary__total">
                    <span>Tổng thanh toán</span>
                    <strong>@tongTienTatCa.ToString("N0")đ</strong>
                </div>

                <a asp-controller="GioHang" asp-action="ThanhToan" class="zz-cart-checkout-btn">
                    Tiến hành thanh toán
                </a>
                <p>Màu sắc và dung lượng sẽ được giữ theo từng dòng sản phẩm trong giỏ.</p>
            </aside>
        </div>
    }
</section>

@section Scripts {
    <script>
        document.addEventListener('click', function (event) {
            const item = event.target.closest('.zz-cart-item');
            if (!item) return;
            if (event.target.closest('a, button, form, input')) return;

            const url = item.dataset.detailUrl;
            if (url) window.location.href = url;
        });
    </script>
}
