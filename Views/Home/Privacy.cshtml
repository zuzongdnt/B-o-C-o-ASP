@{
    ViewData["Title"] = "Chính sách bảo mật";
    ViewData["BodyClass"] = "page-policy";
}

<section class="zz-policy-hero" id="privacyScrolly" data-frame-count="220" data-frame-base="/images/14861093_3840_2160_30fps_">
    <div class="zz-policy-visual" aria-hidden="true">
        <canvas id="privacySequenceCanvas" class="zz-policy-visual__canvas"></canvas>
        <img class="zz-policy-visual__fallback" src="~/images/14861093_3840_2160_30fps_000.jpg" alt="" />
        <div class="zz-policy-visual__shade"></div>
    </div>

    <div class="zz-policy-hero__copy">
        <p class="zz-policy-kicker">Zuzong Store · Chính sách</p>
        <h1>Bảo mật rõ ràng. Mua hàng yên tâm.</h1>
        <p>
            Zuzong Store chỉ thu thập những thông tin cần thiết để tư vấn, giao hàng,
            bảo hành và chăm sóc đơn hàng. Mọi dữ liệu cá nhân đều được dùng đúng mục đích,
            hạn chế truy cập và không bán cho bên thứ ba.
        </p>
        <div class="zz-policy-hero__metrics" aria-label="Cam kết nhanh">
            <span><strong>01</strong>Dữ liệu tối thiểu</span>
            <span><strong>02</strong>Thanh toán minh bạch</span>
            <span><strong>03</strong>Bảo hành có đối soát</span>
        </div>
    </div>

    <div class="zz-policy-story" aria-label="Nội dung chính sách bảo mật">
    <article class="zz-policy-chapter is-active" data-policy-step="0">
        <span>01 · Thu thập</span>
        <h2>Chỉ lấy thông tin cần cho đơn hàng.</h2>
        <p>
            Khi bạn đặt mua sản phẩm, shop cần họ tên, số điện thoại, địa chỉ nhận hàng,
            thông tin tài khoản và lịch sử giao dịch để xác nhận đơn, giao hàng, xuất bảo hành
            và hỗ trợ sau mua.
        </p>
    </article>

    <article class="zz-policy-chapter" data-policy-step="1">
        <span>02 · Sử dụng</span>
        <h2>Dùng đúng việc, không dùng lan man.</h2>
        <p>
            Thông tin được dùng để xử lý đơn, cập nhật trạng thái giao hàng, gửi thông báo
            bảo hành, nhắc lịch hỗ trợ và cải thiện trải nghiệm mua sắm trên website.
        </p>
    </article>

    <article class="zz-policy-chapter" data-policy-step="2">
        <span>03 · Thanh toán</span>
        <h2>Giá, phương thức và xác nhận đều rõ ràng.</h2>
        <p>
            Zuzong Store không yêu cầu bạn gửi dữ liệu nhạy cảm qua tin nhắn công khai.
            Các khoản thanh toán, cọc giữ máy hoặc hoàn tiền đều cần có nội dung chuyển khoản
            và thông tin đối soát để tránh nhầm lẫn.
        </p>
    </article>

    <article class="zz-policy-chapter" data-policy-step="3">
        <span>04 · Chia sẻ</span>
        <h2>Chỉ chia sẻ khi cần giao hàng hoặc theo yêu cầu pháp lý.</h2>
        <p>
            Thông tin nhận hàng có thể được chuyển cho đơn vị vận chuyển. Ngoài trường hợp
            phục vụ giao nhận, bảo hành hoặc yêu cầu hợp pháp từ cơ quan có thẩm quyền,
            shop không bán hay trao đổi dữ liệu khách hàng.
        </p>
    </article>

    <article class="zz-policy-chapter" data-policy-step="4">
        <span>05 · Bảo quản</span>
        <h2>Tài khoản được giới hạn quyền truy cập.</h2>
        <p>
            Dữ liệu đơn hàng và tài khoản được lưu trong hệ thống quản lý của shop, chỉ người
            phụ trách vận hành, tư vấn, bảo hành hoặc quản trị mới có quyền xem theo phạm vi công việc.
        </p>
    </article>

    <article class="zz-policy-chapter" data-policy-step="5">
        <span>06 · Uy tín</span>
        <h2>Shop giữ lịch sử để bảo vệ quyền lợi khách hàng.</h2>
        <p>
            Lịch sử mua hàng, bảo hành, đổi trả và ghi chú hỗ trợ giúp shop xử lý tranh chấp
            minh bạch hơn. Đây là phần nền tảng để Zuzong Store làm việc rõ ràng, có trách nhiệm
            và giữ chữ tín lâu dài.
        </p>
    </article>

    <article class="zz-policy-chapter" data-policy-step="6">
        <span>07 · Quyền của bạn</span>
        <h2>Bạn có thể yêu cầu kiểm tra hoặc cập nhật thông tin.</h2>
        <p>
            Nếu thông tin giao hàng, số điện thoại, địa chỉ hoặc tài khoản bị sai, bạn có thể
            liên hệ shop để cập nhật. Với dữ liệu không còn cần thiết cho bảo hành hoặc nghĩa vụ
            đối soát, shop sẽ hỗ trợ xử lý theo khả năng hệ thống.
        </p>
    </article>
    </div>
</section>

<section class="zz-policy-trust">
    <div>
        <p class="zz-policy-kicker">Cam kết vận hành</p>
        <h2>Một chính sách dễ hiểu để khách mua máy không phải lo chuyện phía sau.</h2>
    </div>
    <div class="zz-policy-trust__grid">
        <div class="zz-policy-trust__item">
            <strong>Minh bạch</strong>
            <span>Thông tin đơn hàng, giá bán, bảo hành và đổi trả được ghi nhận để đối chiếu.</span>
        </div>
        <div class="zz-policy-trust__item">
            <strong>Bảo mật</strong>
            <span>Dữ liệu cá nhân không dùng để mua bán danh sách khách hàng.</span>
        </div>
        <div class="zz-policy-trust__item">
            <strong>Trách nhiệm</strong>
            <span>Shop ưu tiên xử lý nhanh các yêu cầu liên quan đến tài khoản và đơn hàng.</span>
        </div>
    </div>
    <a class="zz-policy-trust__cta" asp-controller="SanPham" asp-action="Index">Tiếp tục mua sắm</a>
</section>

@section Scripts {
<script src="~/js/zuzong-privacy-scrolly.js" asp-append-version="true"></script>
}
