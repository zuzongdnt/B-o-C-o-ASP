@section Scripts {
<script type="module" src="~/js/zuzong-iphone-scrolly.js" asp-append-version="true"></script>

<script>
(function () {
    // Stagger delay cho product cards
    document.querySelectorAll('.zz-products__grid .zz-animate').forEach(function(el, i) {
        el.style.transitionDelay = (i * 0.1) + 's';
    });

    // Animation khi cuộn
    var observer = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
            if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
            }
        });
    }, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });

    document.querySelectorAll('.zz-animate').forEach(function(el) {
        observer.observe(el);
    });


    // Hover Xiaomi: trỏ vào ảnh nào thì đổi tên + mô tả phía trên
    var xiaomiSection = document.querySelector('.zz-xiaomi-evo');

    if (xiaomiSection) {
        var titleEl = xiaomiSection.querySelector('[data-role="title"]');
        var metaEl  = xiaomiSection.querySelector('[data-role="meta"]');
        var descEl  = xiaomiSection.querySelector('[data-role="desc"]');
        var phones  = xiaomiSection.querySelectorAll('.zz-xiaomi-phone');

        function setActivePhone(phone) {
            phones.forEach(function (item) {
                item.classList.remove('is-active');
            });

            phone.classList.add('is-active');

            titleEl.textContent = phone.dataset.title || '';
            metaEl.innerHTML = phone.dataset.meta || '';
            descEl.textContent = phone.dataset.desc || '';
        }

        phones.forEach(function (phone) {
            phone.addEventListener('mouseenter', function () {
                setActivePhone(phone);
            });

            phone.addEventListener('focus', function () {
                setActivePhone(phone);
            });

            phone.addEventListener('click', function () {
                setActivePhone(phone);
            });
        });

        var defaultPhone = xiaomiSection.querySelector('.zz-xiaomi-phone.is-active') || phones[0];

        if (defaultPhone) {
            setActivePhone(defaultPhone);
        }
    }
})();
</script>
}
