@model dienthoai.Models.TaiKhoan

@{
    ViewData["Title"] = "Đổi mật khẩu";
    ViewData["BodyClass"] = "page-account";
}

@section Styles {
    <link rel="stylesheet" href="~/css/zuzong-account.css" asp-append-version="true" />
}

<section class="zz-account-page zz-account-page--compact">
    <div class="zz-account-header">
        <div>
            <p class="zz-account-eyebrow">SECURITY</p>
            <h1>Đổi mật khẩu</h1>
            <span>Trang này chỉ dùng để đổi mật khẩu tài khoản của bạn.</span>
        </div>
        <a asp-action="Details" asp-route-id="@Model.MaTaiKhoan" class="zz-account-pill-btn">Về tài khoản</a>
    </div>

    @if (TempData["ErrorMsg"] != null)
    {
        <div class="zz-account-alert zz-account-alert--danger">@TempData["ErrorMsg"]</div>
    }

    <form asp-action="ChangePassword" method="post" class="zz-account-panel zz-password-panel">
        @Html.AntiForgeryToken()
        <input type="hidden" name="MaTaiKhoan" value="@Model.MaTaiKhoan" />

        <div class="zz-account-panel__head">
            <div>
                <span>@("@" + Model.TenDangNhap)</span>
                <h2>Cập nhật mật khẩu</h2>
            </div>
        </div>

        <div class="zz-account-grid">
            <label class="zz-account-field zz-account-field--wide">
                <span>Mật khẩu hiện tại</span>
                <input type="password" name="matKhauCu" placeholder="Nhập mật khẩu hiện tại..." required />
            </label>

            <label class="zz-account-field">
                <span>Mật khẩu mới</span>
                <input type="password" name="matKhauMoi" placeholder="Tối thiểu 8 ký tự..." required />
            </label>

            <label class="zz-account-field">
                <span>Xác nhận mật khẩu mới</span>
                <input type="password" name="xacNhanMatKhau" placeholder="Nhập lại mật khẩu mới..." required />
            </label>
        </div>

        <div class="zz-password-note">
            Mật khẩu nên có chữ hoa, chữ thường, số và ký tự đặc biệt để bảo vệ đơn hàng của bạn.
        </div>

        <div class="zz-account-actions">
            <button type="submit" class="zz-account-primary-btn">Lưu mật khẩu</button>
            <a asp-action="ForgotPassword" class="zz-account-ghost-btn">Quên mật khẩu</a>
        </div>
    </form>
</section>
