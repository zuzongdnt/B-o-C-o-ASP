@{
    ViewData["Title"] = "Xác thực OTP";
    ViewData["BodyClass"] = "page-auth";
}

<section class="zz-auth-section">
    <video class="zz-auth__video" autoplay loop muted playsinline src="https://dl.dropboxusercontent.com/scl/fi/72vure5fbyg6x4fvuumki/snaptik.vn_7591610668797676821.mp4?rlkey=6g4hmwb36lskt1t57nxzrs3jy&st=xqsxqolr"></video>
    <div class="zz-auth__overlay"></div>

    <div class="zz-auth__container zz-animate zz-animate--up is-visible">
        <div class="zz-glass zz-auth__card">
            <div class="zz-auth__header">
                <h2 class="zz-auth__title">Xác Thực Email</h2>
                <p class="zz-auth__subtitle">Vui lòng nhập mã 6 số vừa gửi tới email</p>
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="zz-auth__alert">@ViewBag.Error</div>
            }

            <form asp-action="VerifyForgotPasswordOtp" method="post" class="zz-auth__form">
                <div class="zz-form-group" style="text-align:center">
                    <input type="text" name="otpNhap" class="zz-input" maxlength="6" placeholder="_ _ _ _ _ _" 
                           style="font-size:28px;letter-spacing:12px;text-align:center" autocomplete="off" autofocus required />
                </div>
                
                <button type="submit" class="zz-auth__btn">Xác Nhận</button>
            </form>
        </div>
    </div>
</section>

@section Scripts {
<script>
    // Chỉ cho phép nhập số
    document.querySelector('input[name=otpNhap]').addEventListener('input', function() {
        this.value = this.value.replace(/\D/g, '').slice(0, 6);
    });
</script>
}