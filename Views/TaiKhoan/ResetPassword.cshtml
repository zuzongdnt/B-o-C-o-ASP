@{
    ViewData["Title"] = "Đặt lại mật khẩu";
    ViewData["BodyClass"] = "page-auth";
}

<section class="zz-auth-section">
    <video class="zz-auth__video" autoplay loop muted playsinline src="https://dl.dropboxusercontent.com/scl/fi/72vure5fbyg6x4fvuumki/snaptik.vn_7591610668797676821.mp4?rlkey=6g4hmwb36lskt1t57nxzrs3jy&st=xqsxqolr"></video>
    <div class="zz-auth__overlay"></div>

    <div class="zz-auth__container zz-animate zz-animate--up is-visible">
        <div class="zz-glass zz-auth__card">
            <div class="zz-auth__header">
                <h2 class="zz-auth__title">Mật Khẩu Mới</h2>
                <p class="zz-auth__subtitle">Tạo mật khẩu mới cho tài khoản của bạn</p>
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="zz-auth__alert">@ViewBag.Error</div>
            }

            <form asp-action="ResetPassword" method="post" class="zz-auth__form">
                <div class="zz-form-group">
                    <label>Mật khẩu mới</label>
                    <input type="password" name="matKhauMoi" class="zz-input" placeholder="Tối thiểu 8 ký tự..." required />
                </div>
                <div class="zz-form-group">
                    <label>Nhập lại mật khẩu mới</label>
                    <input type="password" name="xacNhanMatKhau" class="zz-input" placeholder="Nhập lại mật khẩu..." required />
                </div>
                
                <button type="submit" class="zz-auth__btn">Lưu mật khẩu & Đăng nhập</button>
            </form>
        </div>
    </div>
</section>