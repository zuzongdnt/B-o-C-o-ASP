@{
    ViewData["Title"] = "Quên mật khẩu";
    ViewData["BodyClass"] = "page-auth";
}

<section class="zz-auth-section">
    <video class="zz-auth__video" autoplay loop muted playsinline src="https://dl.dropboxusercontent.com/scl/fi/72vure5fbyg6x4fvuumki/snaptik.vn_7591610668797676821.mp4?rlkey=6g4hmwb36lskt1t57nxzrs3jy&st=xqsxqolr"></video>
    <div class="zz-auth__overlay"></div>

    <div class="zz-auth__container zz-animate zz-animate--up is-visible">
        <div class="zz-glass zz-auth__card">
            <div class="zz-auth__header">
                <h2 class="zz-auth__title">Quên Mật Khẩu</h2>
                <p class="zz-auth__subtitle">Nhập email của bạn để nhận mã xác thực</p>
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="zz-auth__alert">@ViewBag.Error</div>
            }

            <form asp-action="ForgotPassword" method="post" class="zz-auth__form">
                <div class="zz-form-group">
                    <label>Địa chỉ Email</label>
                    <input type="email" name="email" class="zz-input" placeholder="Nhập email đã đăng ký..." required />
                </div>
                
                <button type="submit" class="zz-auth__btn">Gửi mã OTP</button>
                
                <div class="zz-auth__footer">
                    <a asp-action="Login">← Quay lại đăng nhập</a>
                </div>
            </form>
        </div>
    </div>
</section>