@using Microsoft.AspNetCore.Http
@model IEnumerable<dienthoai.Models.SanPham>

@{
    ViewData["Title"] = ViewBag.TenHang != null ? ViewBag.TenHang : "Tất cả sản phẩm";
    ViewData["BodyClass"] = "page-catalog";
    var vaiTro = Context.Session.GetString("VaiTro");
    var xemNhuNguoiDung = Context.Request.Query["previewUser"] == "true";
    var hienNutAdmin = vaiTro == "Admin" && !xemNhuNguoiDung;
}

<link rel="stylesheet" href="~/css/zuzong-product-index.css" asp-append-version="true" />

<section class="zz-catalog-section zz-catalog-section--store">
    <div class="zz-page-header zz-animate zz-animate--up is-visible">
        <div>
            <p class="zz-catalog-eyebrow">ZUZONG Store</p>
            <h2 class="zz-page-title">
                @(ViewBag.TenHang != null ? ViewBag.TenHang.ToString() : "Tất cả sản phẩm")
            </h2>
        </div>

        @if (hienNutAdmin)
        {
            <a asp-action="Create" class="zz-btn zz-btn--primary">+ Thêm sản phẩm</a>
        }
    </div>

    <div class="zz-catalog-toolbar zz-animate zz-animate--up is-visible" style="transition-delay: 0.05s;">
        <div class="zz-search-container">
            <form asp-controller="SanPham" asp-action="Index" method="get" class="zz-search-form" data-product-search-form>
                @if (ViewBag.MaThuongHieu != null)
                {
                    <input type="hidden" name="maThuongHieu" value="@ViewBag.MaThuongHieu" />
                }

                <input type="text"
                       name="keyword"
                       id="zzProductSearchInput"
                       class="zz-search-input"
                       data-product-search-input
                       aria-autocomplete="list"
                       aria-controls="zzSearchSuggestions"
                       aria-expanded="false"
                       placeholder="Tìm kiếm sản phẩm..."
                       value="@ViewBag.CurrentKeyword"
                       autocomplete="off" />

                <button type="submit" class="zz-search-btn" title="Tìm kiếm">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="11" cy="11" r="7.5"></circle>
                        <path d="M20 20l-3.8-3.8"></path>
                    </svg>
                </button>

                <div class="zz-search-suggestions" id="zzSearchSuggestions" role="listbox" aria-label="Gợi ý sản phẩm"></div>
            </form>
        </div>

        <div class="zz-sort-bar zz-sort-bar--catalog">
            <span class="zz-sort-label">Sắp xếp theo</span>

            <div class="zz-sort-buttons zz-sort-buttons--modern">
                <a asp-action="Index"
                   asp-route-maThuongHieu="@ViewBag.MaThuongHieu"
                   asp-route-keyword="@ViewBag.CurrentKeyword"
                   asp-route-previewUser="@(xemNhuNguoiDung ? "true" : null)"
                   asp-route-sortOrder="pho_bien"
                   class="zz-sort-btn @(string.IsNullOrEmpty(ViewBag.CurrentSort) || ViewBag.CurrentSort == "pho_bien" ? "active" : "")">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 2l2.5 6.7 7.1.3-5.6 4.4 1.9 6.9L12 16.3l-5.9 4 1.9-6.9L2.4 9l7.1-.3L12 2z"></path>
                    </svg>
                    <span>Phổ biến</span>
                </a>

                <a asp-action="Index"
                   asp-route-maThuongHieu="@ViewBag.MaThuongHieu"
                   asp-route-keyword="@ViewBag.CurrentKeyword"
                   asp-route-previewUser="@(xemNhuNguoiDung ? "true" : null)"
                   asp-route-sortOrder="khuyen_mai"
                   class="zz-sort-btn @(ViewBag.CurrentSort == "khuyen_mai" ? "active" : "")">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M19 5L5 19"></path>
                        <circle cx="7.5" cy="7.5" r="2"></circle>
                        <circle cx="16.5" cy="16.5" r="2"></circle>
                    </svg>
                    <span>Khuyến mãi</span>
                </a>

                <a asp-action="Index"
                   asp-route-maThuongHieu="@ViewBag.MaThuongHieu"
                   asp-route-keyword="@ViewBag.CurrentKeyword"
                   asp-route-previewUser="@(xemNhuNguoiDung ? "true" : null)"
                   asp-route-sortOrder="gia_thap_cao"
                   class="zz-sort-btn @(ViewBag.CurrentSort == "gia_thap_cao" ? "active" : "")">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M4 7h11"></path>
                        <path d="M4 12h8"></path>
                        <path d="M4 17h5"></path>
                        <path d="M18 7v10"></path>
                        <path d="M15 14l3 3 3-3"></path>
                    </svg>
                    <span>Giá thấp - cao</span>
                </a>

                <a asp-action="Index"
                   asp-route-maThuongHieu="@ViewBag.MaThuongHieu"
                   asp-route-keyword="@ViewBag.CurrentKeyword"
                   asp-route-previewUser="@(xemNhuNguoiDung ? "true" : null)"
                   asp-route-sortOrder="gia_cao_thap"
                   class="zz-sort-btn @(ViewBag.CurrentSort == "gia_cao_thap" ? "active" : "")">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M4 7h5"></path>
                        <path d="M4 12h8"></path>
                        <path d="M4 17h11"></path>
                        <path d="M18 17V7"></path>
                        <path d="M15 10l3-3 3 3"></path>
                    </svg>
                    <span>Giá cao - thấp</span>
                </a>
            </div>
        </div>
    </div>

    <div class="zz-products__grid zz-products__grid--store zz-animate zz-animate--up is-visible" style="transition-delay: 0.2s;">
        @foreach (var item in Model)
        {
            int discountPct = 0;
            if (item.GiaGoc.HasValue && item.GiaGoc > item.GiaBan && item.GiaGoc > 0)
            {
                discountPct = (int)Math.Round((1 - item.GiaBan / item.GiaGoc.Value) * 100);
            }

            var visibleReviews = item.DanhGia?.Where(d => d.TrangThaiHienThi != false && d.SoSao.HasValue).ToList();
            decimal rating = visibleReviews != null && visibleReviews.Any()
                ? (decimal)visibleReviews.Average(d => d.SoSao!.Value)
                : 0;
            int reviewCount = visibleReviews?.Count ?? 0;
            var bienTheMacDinh = item.SanPhamBienThes?
                .Where(x => x.TrangThai)
                .OrderByDescending(x => x.LaMacDinh)
                .ThenBy(x => x.DungLuong)
                .ThenBy(x => x.MauSac)
                .FirstOrDefault();

            <article class="zz-product-card zz-product-card--store">
                <a asp-action="Details" asp-route-id="@item.MaSp" class="zz-product-card__link" aria-label="Xem chi tiết @item.TenSp">
                    <div class="zz-product-card__badges">
                        @if (discountPct > 0)
                        {
                            <span class="zz-discount-badge zz-discount-badge--store">Giảm @discountPct%</span>
                        }
                        <span class="zz-installment-badge">Trả góp 0%</span>
                    </div>

                    <div class="zz-product-card__thumb zz-product-card__thumb--store">
                        @if (!string.IsNullOrEmpty(item.HinhAnh))
                        {
                            <img src="~/images/@item.HinhAnh"
                                 alt="@item.TenSp"
                                 loading="lazy"
                                 onerror="this.src='https://via.placeholder.com/260?text=No+Image'" />
                        }
                        else
                        {
                            <span class="zz-product-card__thumb--placeholder">Phone</span>
                        }
                    </div>

                    <h3 class="zz-product-card__name zz-product-card__name--store" title="@item.TenSp">
                        @item.TenSp
                    </h3>

                    <div class="zz-product-card__price-row zz-product-card__price-row--store">
                        <span class="zz-product-card__price zz-product-card__price--store">@item.GiaBan.ToString("N0")đ</span>
                        @if (item.GiaGoc.HasValue && item.GiaGoc > item.GiaBan)
                        {
                            <span class="zz-product-card__price-old zz-product-card__price-old--store">@item.GiaGoc.Value.ToString("N0")đ</span>
                        }
                    </div>

                    <div class="zz-product-card__specs zz-product-card__specs--store">
                        @if (!string.IsNullOrEmpty(item.Chipset)) { <span>@item.Chipset</span> }
                        @if (!string.IsNullOrEmpty(item.Ram)) { <span>@item.Ram</span> }
                        @if (!string.IsNullOrEmpty(item.Rom)) { <span>@item.Rom</span> }
                    </div>

                    <div class="zz-product-card__installment">
                        Trả góp 0% - 0đ phụ phí - 0đ trả trước - kỳ hạn đến 6 tháng
                    </div>
                </a>

                <div class="zz-product-card__bottom">
                    <div class="zz-product-rating" aria-label="Đánh giá sản phẩm">
                        <svg width="21" height="21" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                            <path d="M12 2.7l2.8 5.7 6.3.9-4.5 4.4 1.1 6.3-5.7-3-5.7 3 1.1-6.3-4.5-4.4 6.3-.9L12 2.7z"></path>
                        </svg>
                        <strong>@(rating > 0 ? rating.ToString("0.#") : "0")</strong>
                        @if (reviewCount > 0)
                        {
                            <span>(@reviewCount)</span>
                        }
                    </div>

                    <div class="zz-product-card__actions zz-product-card__actions--store">
                        @if (hienNutAdmin)
                        {
                            <a asp-action="Edit" asp-route-id="@item.MaSp" class="zz-btn-sm zz-btn-sm--outline">Sửa</a>
                            <a asp-action="Delete" asp-route-id="@item.MaSp" class="zz-btn-sm zz-btn-sm--danger">Xóa</a>
                        }
                        else
                        {
                            <button type="button"
                                    class="zz-btn-sm zz-btn-sm--outline"
                                    data-them-gio="@item.MaSp"
                                    data-ma-bien-the="@bienTheMacDinh?.MaBienThe"
                                    title="Thêm vào giỏ">
                                Thêm
                            </button>
                            <a asp-controller="GioHang"
                               asp-action="MuaNgay"
                               asp-route-maSp="@item.MaSp"
                               asp-route-maBienThe="@bienTheMacDinh?.MaBienThe"
                               class="zz-btn-sm zz-btn-sm--primary">
                                Mua ngay
                            </a>
                        }
                    </div>
                </div>
            </article>
        }

        @if (!Model.Any())
        {
            <div class="zz-empty-products">
                <p>Không tìm thấy sản phẩm nào</p>
            </div>
        }
    </div>
</section>
@section Scripts {
    <script src="~/js/zuzong-product-search.js" asp-append-version="true"></script>
}